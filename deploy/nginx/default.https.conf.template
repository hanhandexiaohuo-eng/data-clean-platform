# ============================================================
# Nginx 同源入口（HTTPS，模板）
# ------------------------------------------------------------
# 启用方式（证书就绪后）：
#   docker compose -f docker-compose.yml -f deploy/docker-compose.https.yml up -d --build
# 模板变量仅白名单替换，禁止对 $uri/$host/$remote_addr 做 envsubst。
# ============================================================

limit_req_zone $binary_remote_addr zone=api_zone:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=upload_zone:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ai_zone:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=addr:10m;

# 访问日志脱敏：不记录来源地址明文与查询串
log_format safe_main '[$time_local] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;
    limit_req_status 429;
    limit_conn_status 429;
    access_log /var/log/nginx/access.log safe_main;
    error_log  /var/log/nginx/error.log crit;
    # 非法 Host 直接断开，避免开放重定向到任意域名
    if ($host != "${NGINX_SERVER_NAME}") {
        return 444;
    }
    # HTTP 自动跳转 HTTPS
    return 301 https://$host$request_uri;
}

# 容器内健康探针：仅容器网络可达（compose 不发布 8080），
# 避免 80 端口健康检查被 301 跳转干扰，也不破坏「HTTP 全量跳转」语义。
server {
    listen 8080;
    server_name _;
    access_log off;
    location = /nginx-health {
        default_type text/plain;
        return 200 'ok';
    }
    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    server_tokens off;
    charset utf-8;

    limit_req_status 429;
    limit_conn_status 429;

    # 非法 Host 直接断开（配合入口脚本强制要求真实域名）
    if ($host != "${NGINX_SERVER_NAME}") {
        return 444;
    }

    ssl_certificate     ${NGINX_HTTPS_CERT};
    ssl_certificate_key ${NGINX_HTTPS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS（确认全站 HTTPS 后再开启）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;

    # 上游/网关 5xx 统一脱敏
    proxy_intercept_errors on;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;
    error_page 502 504 = @gateway_error;
    error_page 404 = @not_found;

    location @gateway_error {
        internal;
        default_type application/json;
        return 502 '{"code":502,"message":"服务暂不可用"}';
    }

    location @not_found {
        internal;
        default_type application/json;
        return 404 '{"code":404,"message":"资源不存在"}';
    }

    access_log /var/log/nginx/access.log safe_main;
    error_log  /var/log/nginx/error.log crit;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_timeout 30s;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location = /api/health {
        return 404;
    }

    location /api/admin/ {
        return 404;
    }

    # 运行指标与诊断接口仅在容器内部网络访问
    location /actuator/ {
        return 404;
    }

    location /api/ops/ {
        return 404;
    }

    # AI 治理/审计接口不对外暴露（公开模式后端亦拒绝）
    location /api/ai/governance/ {
        return 404;
    }

    location ~ ^/api/(public/ai/challenge|ai/generate) {
        limit_req zone=ai_zone burst=3 nodelay;
        limit_conn addr 4;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    location = /api/dataset/upload {
        limit_req zone=upload_zone burst=3 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location /api/ {
        limit_req zone=api_zone burst=60 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /assets/ {
        # 必须显式声明 root：server 级未设置 root，仅 location / 内设置了
        root /usr/share/nginx/html;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        # 子 location 的 add_header 会覆盖 server 级配置，需重复安全头
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
    }

    location ~ /\. {
        deny all;
    }
}
