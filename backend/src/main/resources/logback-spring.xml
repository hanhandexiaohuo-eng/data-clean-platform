<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志输出策略：
    - 控制台：面向容器 stdout，由 Docker 日志驱动负责轮转；
    - 文件：按天 + 50MB 滚动，保留 14 天，总容量上限 1GB（均可通过环境变量调整）；
    - 不记录 SQL、参数、密码、Cookie、JWT、AI Key 或原始敏感数据（由业务代码保证）。
-->
<configuration scan="false">

    <property name="LOG_DIR" value="${LOG_PATH:-./logs}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/dataclean.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/dataclean.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE:-50MB}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY:-14}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP:-1GB}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="${ROOT_LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
