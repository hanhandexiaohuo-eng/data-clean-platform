# ============================================================
# DataClean 平台 - 环境变量模板
# ------------------------------------------------------------
# 说明：
#   Spring Boot 不会自动读取 .env 文件，本文件仅作为
#   「需要配置哪些变量」的清单与文档。
#
#   实际注入方式（Windows PowerShell）：
#     $env:DB_USERNAME = "your_db_username"
#     $env:DB_PASSWORD = "your_db_password"
#     $env:JWT_SECRET  = "your_random_secret"
#     .\start_backend.ps1
#
#   或永久写入当前用户环境变量：
#     [Environment]::SetEnvironmentVariable("DB_PASSWORD", "your_db_password", "User")
#
# 使用步骤：
#   1. 复制本文件为 .env（.env 已在 .gitignore 中，不会被提交）
#   2. 填入真实值
#   3. 按上面方式导入到环境变量
# ============================================================

# ---------- 数据库 ----------
# 连接地址（含 host / port / 库名），不包含账号密码
DB_URL=jdbc:mysql://localhost:3306/dataclean?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowMultiQueries=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ---------- JWT ----------
# 签名密钥，务必使用随机长字符串（>= 32 位）
# 生成方式（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_MIN_SECRET

# ---------- 管理员初始账号（如已改为可配置）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ---------- 文件上传 ----------
UPLOAD_PATH=./uploads

# ============================================================
# 以下为 AI 大模型配置说明：
#   本项目的大模型 API Key 不放在环境变量中，而是运行时
#   通过「AI 配置」页面写入数据库 ai_config.api_key 字段。
#   上传仓库前请确认数据库中没有真实 Key 被导出为 .sql 文件。
# ============================================================
