# ============================================================
# DataClean 平台 - 生产部署环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   填写真实值（.env 已被 .gitignore 忽略，禁止提交/打包/贴日志）
#   docker compose up -d --build
#
# 约定：
#   - 标注「必填」的变量缺失时 Compose 会拒绝启动；
#   - 所有示例值均为占位符，禁止直接用于生产；
#   - 变量只通过环境变量注入容器，不写入镜像。
# ============================================================

# ------------------------------------------------------------
# 运行环境（可选）
# ------------------------------------------------------------
# 时区，格式：IANA 时区名；默认 Asia/Shanghai
TZ=Asia/Shanghai
# 对外 HTTP 端口，格式：1-65535 整数；默认 80
HTTP_PORT=80

# ------------------------------------------------------------
# MySQL（必填，仅内部网络，不发布宿主机端口）
# ------------------------------------------------------------
# root 密码：必填，>= 16 位随机串；仅用于容器初始化，不注入后端
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_16_CHARS_MIN
# 业务库名：可选，默认 dataclean；格式：字母/数字/下划线
MYSQL_DATABASE=dataclean
# 应用账号：必填，禁止使用 root；格式：字母/数字/下划线
MYSQL_USER=dataclean_app
# 应用账号密码：必填，>= 16 位随机串；后端与迁移容器共用
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD_16_CHARS_MIN
# 迁移锁等待秒数：可选，默认 60；并发部署时用于串行化迁移
MIGRATION_LOCK_TIMEOUT=60

# ------------------------------------------------------------
# 后端认证（必填）
# ------------------------------------------------------------
# JWT 签名密钥：必填，>= 32 位随机字符串；变更会使已签发 Token 全部失效
# 生成示例（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=CHANGE_ME_RANDOM_32_CHARS_MIN
# Token 有效期（毫秒）：可选，默认 604800000（7 天）
JWT_EXPIRATION=604800000

# ------------------------------------------------------------
# AI 密钥加密主密钥（必填）
# ------------------------------------------------------------
# AES-256-GCM 主密钥：必填，Base64 编码的 32 字节随机值
# 生成示例（PowerShell）：
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
# 该密钥只用于加解密数据库中的 AI Key 密文，禁止与数据库备份放在一起
AI_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES
# 单次送入模型的 Prompt 最大字符数：可选，正整数，默认 20000
AI_MAX_PROMPT_CHARS=20000
# AI 统一调用治理开关：可选，默认 true；仅回滚旧版 ai_config 直连时临时关闭
AI_GOVERNANCE_ENABLED=true
# AI 审计主体 HMAC 盐：生产必填，>= 32 位随机串，禁止复用 JWT_SECRET / PUBLIC_IP_HASH_PEPPER
AI_AUDIT_PEPPER=CHANGE_ME_AI_AUDIT_PEPPER_32_CHARS_MIN

# ------------------------------------------------------------
# 初始管理员（可选）
# ------------------------------------------------------------
# 仅当库中不存在该用户名时创建；两者都为空则跳过，不产生默认密码
# 密码格式：>= 12 位，建议包含大小写字母、数字与符号
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------
# 上传与清洗（可选）
# ------------------------------------------------------------
# 单文件大小上限：格式如 100MB；需 <= UPLOAD_MAX_REQUEST_SIZE
UPLOAD_MAX_FILE_SIZE=100MB
# 单请求大小上限：格式如 200MB；需与 Nginx client_max_body_size 保持一致
UPLOAD_MAX_REQUEST_SIZE=200MB
# 单文件最大行数：正整数，默认 500000
UPLOAD_MAX_ROWS=500000
# 单文件最大列数：正整数，默认 1000
UPLOAD_MAX_COLUMNS=1000
# Excel 最大工作表数：正整数，默认 20
UPLOAD_MAX_EXCEL_SHEETS=20
# 自定义表达式过滤：默认 false（下线）；开启前请评估表达式注入风险
CLEAN_CUSTOM_FILTER_ENABLED=false

# ------------------------------------------------------------
# 跨域（可选）
# ------------------------------------------------------------
# 生产使用 Nginx 同源反向代理，保持为空即可；
# 如确有独立域名前端，填写完整 Origin（逗号分隔），例如 https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# 日志（可选）
# ------------------------------------------------------------
# 应用日志级别：trace/debug/info/warn/error，默认 info
LOG_LEVEL=info
# 单日志文件大小上限：格式如 50MB
LOG_MAX_FILE_SIZE=50MB
# 日志保留天数：正整数，默认 14
LOG_MAX_HISTORY=14
# 日志总容量上限：格式如 1GB
LOG_TOTAL_SIZE_CAP=1GB

# ============================================================
# 公开演示与临时工作区（第三阶段，可选）
# ------------------------------------------------------------
# APP_MODE=private 时以下变量不生效；PUBLIC_* 仅在 APP_MODE=public 时校验。
# ============================================================
# 运行模式：private（默认，保留登录与真实数据）/ public（免登录公开演示）
APP_MODE=private
# 固定公开源站白名单：必填（public 模式），逗号分隔，禁止 *；生产必须 https
# 例：PUBLIC_ALLOWED_ORIGIN=https://demo.example.com
PUBLIC_ALLOWED_ORIGIN=
# 独立 IP 摘要密钥：必填（public 模式），>= 32 位随机串，禁止复用 JWT_SECRET
PUBLIC_IP_HASH_PEPPER=
# 匿名会话有效期（小时）：1-168，默认 24
PUBLIC_SESSION_TTL_HOURS=24
# 匿名会话/配额
PUBLIC_MAX_ACTIVE_SESSIONS=5000
PUBLIC_MAX_ACTIVE_SESSIONS_PER_IP=10
PUBLIC_SESSION_CREATE_PER_IP_PER_DAY=20
PUBLIC_SESSION_CHALLENGE_ENABLED=true
PUBLIC_SESSION_CHALLENGE_THRESHOLD=3
PUBLIC_MAX_DATASETS=5
PUBLIC_MAX_FILE_SIZE_MB=20
PUBLIC_MAX_TOTAL_STORAGE_MB=100
PUBLIC_MAX_ROWS=100000
PUBLIC_MAX_COLUMNS=200
PUBLIC_MAX_CLEAN_TASKS=50
PUBLIC_MAX_CHARTS=100
PUBLIC_MAX_EXPORTS=20
PUBLIC_EXPORT_MAX_ROWS=10000
# 公开 AI：默认关闭；开启后仍受会话/IP/全站配额与 Token 预算约束
PUBLIC_AI_ENABLED=false
PUBLIC_AI_MAX_CALLS_PER_DAY=20
PUBLIC_AI_MAX_CALLS_PER_IP_PER_DAY=60
PUBLIC_AI_GLOBAL_DAILY_CALLS=500
PUBLIC_AI_GLOBAL_DAILY_TOKEN_BUDGET=200000
PUBLIC_AI_MAX_INPUT_CHARS=4000
PUBLIC_AI_MAX_OUTPUT_TOKENS=1024
PUBLIC_AI_MAX_CONCURRENCY=1
PUBLIC_AI_TIMEOUT_MS=30000
PUBLIC_AI_BREAKER_ENABLED=true
PUBLIC_AI_CHALLENGE_ENABLED=true
PUBLIC_AI_CHALLENGE_DIFFICULTY=18
PUBLIC_AI_CHALLENGE_TTL_SECONDS=120
# 演示数据与清理任务
PUBLIC_DEMO_DATA_ENABLED=true
PUBLIC_CLEANUP_ENABLED=true
PUBLIC_CLEANUP_INTERVAL_MINUTES=60
PUBLIC_CLEANUP_GRACE_MINUTES=60
# Nginx 请求体上限：需与 UPLOAD_MAX_REQUEST_SIZE 协调，例 25m/200m
NGINX_CLIENT_MAX_BODY_SIZE=25m
# HTTPS 覆盖时使用（deploy/docker-compose.https.yml）
PUBLIC_SERVER_NAME=
HTTPS_PORT=443

# ------------------------------------------------------------
# 受信代理与监控（可选，Compose 部署建议显式确认）
# ------------------------------------------------------------
# 仅该网段直连请求才采信 X-Real-IP；默认与 app_net 固定子网一致，禁止 0.0.0.0/0
TRUSTED_PROXY_CIDRS=172.30.0.0/24,127.0.0.1/32,::1/128
# Prometheus 仅绑定宿主机回环，经 SSH 隧道访问；不进入安全组放行范围
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
# 扫描网关单文件上限（字节），需 >= Nginx 请求体上限中的文件部分
SCAN_MAX_FILE_BYTES=33554432
SCAN_UPSTREAM_TIMEOUT_MS=6000

# ------------------------------------------------------------
# 本地开发（可选，Compose 部署不需要）
# ------------------------------------------------------------
# 直接在宿主机运行后端时，可用以下变量连接本机 MySQL；
# Compose 会用自己的内部连接串覆盖，不会读取这三项。
# DB_URL=jdbc:mysql://127.0.0.1:3306/dataclean?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# DB_USERNAME=CHANGE_ME_LOCAL_DB_USER
# DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# ============================================================
# 说明：
#   - AI 供应商 API Key 不写入环境变量，只经「AI 配置」页面提交，
#     服务端使用 AI_SECRET_KEY 加密入库，接口仅返回掩码；
#   - 上传目录固定为容器内 /app/uploads，日志目录固定为 /app/logs，
#     分别对应命名卷 dataclean_uploads / dataclean_logs，避免误配宿主机路径。
# ============================================================
