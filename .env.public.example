# ============================================================
# 公开演示模式最小环境变量（第三阶段）
# ------------------------------------------------------------
# 用法：
#   cp .env.public.example .env
#   填写 PUBLIC_ALLOWED_ORIGIN 与 PUBLIC_IP_HASH_PEPPER 后启动
# 说明：
#   - 其余必填项（MySQL/JWT/AI_SECRET_KEY）请参考 .env.example；
#   - 生产公开模式 Cookie 固定 Secure，禁止通过 .env 关闭；
#     本地 HTTP 调试请使用 backend 的 local Profile（application-local.yml）。
# ============================================================
APP_MODE=public

# 固定公开源站（必须与浏览器地址栏完全一致，含 https）
PUBLIC_ALLOWED_ORIGIN=https://demo.example.com

# 独立 HMAC 密钥（>=32 位，勿与 JWT_SECRET 相同）
PUBLIC_IP_HASH_PEPPER=CHANGE_ME_PUBLIC_IP_PEPPER_32_CHARS_MIN

# 对外域名（仅域名，不含 https://）；HTTPS 覆盖文件会把它渲染到 server_name
PUBLIC_SERVER_NAME=demo.example.com

PUBLIC_SESSION_TTL_HOURS=24
# 匿名会话 Cookie 名称固定为 __Host-dc_anon（Secure/HttpOnly/Strict/Path=/、无 Domain）
PUBLIC_COOKIE_NAME=__Host-dc_anon

# 会话创建防护：单 IP 每自然日上限、全站活跃上限、单 IP 活跃上限、
# 当日达到阈值后强制一次性挑战令牌
PUBLIC_SESSION_CREATE_PER_IP_PER_DAY=20
PUBLIC_MAX_ACTIVE_SESSIONS=5000
PUBLIC_MAX_ACTIVE_SESSIONS_PER_IP=10
PUBLIC_SESSION_CHALLENGE_ENABLED=true
PUBLIC_SESSION_CHALLENGE_THRESHOLD=3

# 上传临时文件 TTL 与清理间隔（分钟）
UPLOAD_TEMP_TTL_MINUTES=120
UPLOAD_TEMP_CLEAN_INTERVAL_MINUTES=60
# 恶意文件扫描：公开模式强制要求 http 扫描服务（none 会拒绝启动）
UPLOAD_SCAN_PROVIDER=http
UPLOAD_SCAN_REQUIRED=true
UPLOAD_SCAN_URL=http://scanner:8080/scan
UPLOAD_SCAN_TIMEOUT_MS=5000
UPLOAD_SCAN_MAX_RESPONSE_BYTES=65536
# 扫描服务访问令牌（如启用），不得提交仓库
UPLOAD_SCAN_TOKEN=

# 扫描栈（deploy/docker-compose.scan.yml）
# 内网无法访问 database.clamav.net 时：true = 关闭 freshclam，改用宿主机预置病毒库
CLAMAV_NO_FRESHCLAMD=false
# 小内存主机降低 clamd 线程数；建议 <4GB 主机仅保留 daily.cvd
CLAMAV_MAX_THREADS=4
CLAMAV_DNS_1=223.5.5.5
CLAMAV_DNS_2=119.29.29.29

# 仅受信反向代理网段可采信 X-Real-IP；默认与 Compose app_net 固定子网一致，
# 禁止 0.0.0.0/0；修改 app_net 子网时必须同步修改
TRUSTED_PROXY_CIDRS=172.30.0.0/24,127.0.0.1/32,::1/128

# AI 治理审计盐（生产必须配置 >=32 位随机串；勿复用其它密钥）
AI_AUDIT_PEPPER=CHANGE_ME_AI_AUDIT_PEPPER_32_CHARS_MIN

# 运行监控与告警阈值（相对值 0-1 或计数）
MANAGEMENT_PORT=8081
MONITORING_INTERVAL_SECONDS=60
UPLOAD_VOLUME_CAPACITY_MB=1024
ALERT_SESSION_CAPACITY_RATIO=0.8
ALERT_UPLOAD_VOLUME_RATIO=0.85
ALERT_DB_POOL_RATIO=0.9
ALERT_AI_BUDGET_RATIO=0.9
ALERT_CLEANUP_FAILURES=3
ALERT_ORPHAN_TABLES=10
ALERT_SCAN_FAILURES_PER_INTERVAL=3

PUBLIC_AI_ENABLED=false
PUBLIC_DEMO_DATA_ENABLED=true
PUBLIC_CLEANUP_ENABLED=true
PUBLIC_CLEANUP_INTERVAL_MINUTES=60

NGINX_CLIENT_MAX_BODY_SIZE=25m
# 仅发布 80/443；443 由 HTTPS 覆盖文件使用
HTTP_PORT=80
HTTPS_PORT=443
