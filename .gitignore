# ============================================================
# DataClean 平台 - Git 忽略规则
# 目的：防止密钥、构建产物、个人环境信息被提交到公开仓库
# ============================================================

# ------------------------------------------------------------
# 【最高优先级】真实配置与密钥文件 —— 绝不能提交
# ------------------------------------------------------------
# Spring 真实配置（含数据库密码、JWT 密钥）
application.yml
application-*.yml
application.properties
application-*.properties
# 例外：示例模板需要提交，供他人复制
!*.example.yml
!*.example.properties

# 环境变量文件
.env
.env.*
!.env.example

# 密钥 / 证书
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
*.ppk
secrets.*
*credential*
*secret*.json

# ------------------------------------------------------------
# Java / Maven 构建产物
# ------------------------------------------------------------
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.nar
# 注意：*.jar 会连带忽略 Maven Wrapper 的 jar，下面两条例外必须保留
!mvnw
!mvnw.cmd
!**/maven-wrapper.jar
.mvn/timing.properties
hs_err_pid*
replay_pid*
.mtj.tmp/

# ------------------------------------------------------------
# Node / Vue / Vite
# ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml

# ------------------------------------------------------------
# IDE / 编辑器（含个人运行配置、数据源信息）
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ------------------------------------------------------------
# 运行时数据 / 上传文件 / 日志
# ------------------------------------------------------------
uploads/
logs/
log/
*.log
*.log.*
tmp/
temp/

# ------------------------------------------------------------
# 数据库与数据文件（避免误提交真实数据）
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.mdb
*.csv
*.xlsx
*.xls
# SQL 备份文件可能含 ai_config 表的真实 API Key 与业务数据，禁止提交
# 例外：sql/ 目录下的建表脚本需要提交
*.sql
!sql/*.sql

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
